{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite/esbuild handles emit, TS only type-checks */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    /* The .ts files import the project's own JavaScript (client.js, sentry.js,
       dates.js …). allowJs lets TypeScript read their types; checkJs stays off,
       so the JavaScript is not itself type-checked. (BUG-051.) */
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    /* Strict checks */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* React */
    "jsx": "react-jsx"

    /* Path aliases: none. TypeScript 7 removed "baseUrl"; if aliases are ever
       needed, use "paths" with paths relative to this file. */
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
